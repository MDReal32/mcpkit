{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "usemcpkit-upstream",
  "projectType": "library",
  "implicitDependencies": ["usemcpkit-core", "usemcpkit-http", "usemcpkit-manifest", "usemcpkit-testing"],
  "targets": {
    "test": {
      "command": "cargo test -p usemcpkit-upstream",
      "inputs": ["default", "^production", "cargo"]
    },
    "lint": {
      "command": "cargo fmt -p usemcpkit-upstream --check && cargo clippy -p usemcpkit-upstream --all-targets",
      "inputs": ["default", "^production", "cargo"]
    }
  }
}
