{
  "name": "@usemcpkit/core",
  "version": "0.13.3",
  "description": "The usemcpkit manifest format: types, the server SDK and the credentials form contract.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDReal32/mcpkit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/main.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./build/usemcpkit.core.d.ts",
        "import": "./build/usemcpkit.core.js"
      }
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@microsoft/api-extractor": "^7.59.4",
    "@usemcpkit/testing": "workspace:*",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "5.1.2",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
