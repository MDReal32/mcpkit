{
  "name": "@usemcpkit/servers",
  "version": "0.5.0",
  "private": true,
  "description": "Server definitions the registry manifests are compiled from.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/mcpkit.servers.d.ts",
      "import": "./build/mcpkit.servers.js"
    }
  },
  "scripts": {
    "build": "vite build --configLoader runner",
    "generate": "tsx generator/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@usemcpkit/core": "workspace:*",
    "@usemcpkit/testing": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "5.1.2",
    "vitest": "^4.0.0",
    "yaml": "2.9.0"
  },
  "license": "MIT"
}
