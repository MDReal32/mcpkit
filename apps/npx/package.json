{
  "name": "usemcpkit",
  "version": "0.13.3",
  "description": "npx usemcpkit: runs the usemcpkit binary of this machine, which adds usemcpkit to every AI client with no command.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDReal32/mcpkit.git",
    "directory": "apps/npx"
  },
  "type": "module",
  "bin": "build/usemcpkit.npx.js",
  "publishConfig": {
