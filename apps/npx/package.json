{
  "name": "usemcpkit",
  "version": "0.7.0",
  "description": "npx usemcpkit: adds mcpkit to every AI client on this computer. Runs @usemcpkit/cli.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MDReal32/mcpkit.git",
    "directory": "apps/npx"
  },
  "type": "module",
  "bin": "build/mcpkit.npx.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build/mcpkit.npx.js"
  ],
  "scripts": {
    "build": "vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@usemcpkit/cli": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT"
}
