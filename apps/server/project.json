{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "usemcpkit-servers",
  "projectType": "application",
  "implicitDependencies": [
    "usemcpkit-auth",
    "usemcpkit-core",
    "usemcpkit-credentials-form",
    "usemcpkit-execution",
    "usemcpkit-http",
    "usemcpkit-manifest",
    "usemcpkit-registry",
    "usemcpkit-runner",
    "usemcpkit-testing",
    "usemcpkit-upstream",
    "usemcpkit-wire-log",
    "@usemcpkit/servers",
    "@usemcpkit/ui"
  ],
  "targets": {
    "build": {
      "command": "cargo build --release -p usemcpkit-servers",
      "inputs": ["production", "^production", "cargo", "{workspaceRoot}/packages/ui/build/usemcpkit.ui.html"],
      "outputs": [
        "{workspaceRoot}/target/release/usemcpkit-servers",
        "{workspaceRoot}/target/release/usemcpkit-servers.exe"
      ]
    },
    "test": {
      "command": "cargo test -p usemcpkit-servers",
      "inputs": ["default", "^production", "cargo", "{workspaceRoot}/packages/servers/build/manifests/**/*"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "command": "cargo fmt -p usemcpkit-servers --check && cargo clippy -p usemcpkit-servers --all-targets",
      "inputs": ["default", "^production", "cargo"],
      "dependsOn": ["^build"]
    }
  }
}
