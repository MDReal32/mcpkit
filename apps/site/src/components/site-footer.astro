---
import { NPM_URL, REPOSITORY_URL } from "../const";
---

<footer class="footer">
  <div class="container footer-inner">
    <span>usemcpkit · Open source, MIT licensed</span>
    <nav aria-label="Project links">
      <a href={REPOSITORY_URL}>GitHub</a>
      <a href={NPM_URL}>npm</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding: 32px 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }
</style>
