---
import { NPM_URL, REPOSITORY_URL, SUPPORTED_CLIENTS, TOOL_COUNT_LABEL } from "../const";
import ConnectWindow from "./connect-window.astro";
import InstallCommand from "./install-command.astro";
---

<section class="hero">
  <div class="container hero-grid">
    <div class="copy">
      <p class="eyebrow">Open source · MIT</p>
      <h1>Connect your AI to every tool you use.</h1>
      <p class="lead">
        One install gives Claude, Cursor, Codex and {SUPPORTED_CLIENTS.length - 3} other AI clients access to GitHub,
        Jira, Figma, Cloudflare and {TOOL_COUNT_LABEL} more actions. Set it up in a minute.
      </p>
      <div class="actions">
        <InstallCommand />
        <div class="links">
          <a href="#servers">Browse integrations</a>
          <a href={REPOSITORY_URL}>GitHub</a>
          <a href={NPM_URL}>npm</a>
        </div>
      </div>
      <div class="terminal" aria-hidden="true">
        <p><span class="dim">$</span> npx usemcpkit</p>
        <p class="step"><span class="mark">◆</span> Add usemcpkit to which clients?</p>
        <p class="choice"><span class="on">◼</span> Claude Code <span class="on">◼</span> Cursor <span class="off">◻</span> VS Code</p>
        <p class="step"><span class="ok">✓</span> Restart the clients to load usemcpkit.</p>
      </div>
    </div>
    <div class="visual">
      <ConnectWindow />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 80px 0 104px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 64px;
    align-items: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 5.4vw, 60px);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .lead {
    max-width: 560px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: clamp(17px, 2vw, 19px);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin-top: 34px;
  }

  .links {
    display: flex;
    gap: 22px;
    font-family: var(--mono);
    font-size: 13px;
  }

  .links a {
    color: var(--muted);
    text-underline-offset: 4px;
  }

  .links a:hover {
    color: var(--text);
  }

  .terminal {
    max-width: 460px;
    margin-top: 40px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.9;
  }

  .terminal p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dim,
  .off {
    color: var(--quiet);
  }

  .mark,
  .on {
    color: var(--accent);
  }

  .ok {
    color: #7ee0a5;
  }

  .choice {
    padding-left: 16px;
    color: var(--muted);
  }

  .visual {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 920px) {
    .hero {
      padding: 56px 0 72px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .copy .eyebrow {
      justify-content: center;
    }

    .actions {
      align-items: center;
    }

    .terminal {
      width: 100%;
      text-align: left;
    }
  }
</style>
