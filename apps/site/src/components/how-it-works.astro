---
import { FEATURES, PROMO_POSTER_URL, PROMO_VIDEO_URL } from "../const";
---

<section class="section" id="how-it-works">
  <div class="container">
    <p class="eyebrow">How it works</p>
    <h2 class="section-title">Install once. Ask for anything.</h2>
    <p class="section-lead">
      No setup per app and nothing to configure. Add usemcpkit to your AI client, connect the apps you use, and ask in
      plain words.
    </p>

    <div class="split">
      <ol class="steps">
        <li>
          <span class="step-number">1</span>
          <div>
            <h3>Add it to your AI</h3>
            <p>Run one command and pick your AI apps. Every integration is ready from then on.</p>
          </div>
        </li>
        <li>
          <span class="step-number">2</span>
          <div>
            <h3>Ask for what you need</h3>
            <p>"Summarise my open pull requests." "Move this ticket to Done." Your AI finds the right app and does it.</p>
          </div>
        </li>
        <li>
          <span class="step-number">3</span>
          <div>
            <h3>Connect when asked</h3>
            <p>
              The first time an app needs access, a small window lets you sign in. After that it just works, and your
              details stay on your computer.
            </p>
          </div>
        </li>
      </ol>
      <video
        src={PROMO_VIDEO_URL}
        poster={PROMO_POSTER_URL}
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        aria-label="A 30-second tour of usemcpkit"></video>
    </div>

    <ul class="features">
      {
        FEATURES.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 56px;
    align-items: center;
    margin-top: 56px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    gap: 18px;
  }

  .step-number {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--accent-border);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 14px;
  }

  h3 {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .steps p,
  .features p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  video {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 16px;
    margin: 72px 0 0;
    padding: 0;
    list-style: none;
  }

  .features li {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
