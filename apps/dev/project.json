{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "usemcpkit-dev",
  "projectType": "application",
  "implicitDependencies": ["usemcpkit-registry", "usemcpkit-runner", "usemcpkit-servers", "@usemcpkit/servers"],
  "targets": {
    "build": {
      "command": "cargo build --release -p usemcpkit-dev",
      "inputs": [
        "production",
        "^production",
        "cargo",
        "{workspaceRoot}/packages/ui/build/usemcpkit.ui.html",
        "{workspaceRoot}/packages/servers/build/manifests/**/*"
      ],
      "outputs": ["{workspaceRoot}/target/release/usemcpkit-dev", "{workspaceRoot}/target/release/usemcpkit-dev.exe"]
    },
    "test": {
      "command": "cargo test -p usemcpkit-dev",
      "inputs": ["default", "^production", "cargo", "{workspaceRoot}/packages/servers/build/manifests/**/*"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "command": "cargo fmt -p usemcpkit-dev --check && cargo clippy -p usemcpkit-dev --all-targets",
      "inputs": ["default", "^production", "cargo"],
      "dependsOn": ["^build"]
    }
  }
}
