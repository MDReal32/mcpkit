{
  "name": "@usemcpkit/analytics",
  "version": "0.9.0",
  "private": true,
  "description": "Cloudflare Worker that counts anonymous tool use reported by the CLI.",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "lint": "biome check .",
    "dev": "wrangler dev",
    "init": "wrangler d1 create usemcpkit-analytics",
    "db:migrate": "wrangler d1 migrations apply usemcpkit-analytics --remote",
    "db:top": "wrangler d1 execute usemcpkit-analytics --remote --command \"SELECT tool, count AS uses FROM usage ORDER BY uses DESC LIMIT 20\"",
    "deploy": "wrangler deploy",
    "preview": "wrangler versions upload"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "4.152.0"
  }
}
